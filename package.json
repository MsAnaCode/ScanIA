    "base64-arraybuffer": "^1.0.2",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.4",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.5",
    "expo-image-picker": "~58.0.6",
    "expo-linking": "~58.0.5",
    "expo-router": "~58.0.17",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.54.2",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.6.2",
